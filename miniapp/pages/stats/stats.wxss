.grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}

.stat {
  width: 50%;
  padding: 0 6rpx 16rpx 0;
  box-sizing: border-box;
}

.stat:nth-child(2n) {
  padding-right: 0;
  padding-left: 6rpx;
}

.num {
  background: #fafbf6;
  border: 1rpx solid #d6dbd0;
  border-radius: 20rpx;
  padding: 26rpx 24rpx 14rpx;
  font-size: 48rpx;
  line-height: 1.1;
}

.unit {
  font-size: 22rpx;
  color: #6b7c7c;
  margin-left: 4rpx;
}

.lab {
  font-size: 22rpx;
  color: #6b7c7c;
  margin-top: 10rpx;
  padding-left: 4rpx;
}

.kvs {
  margin-top: 16rpx;
}

.kv {
  display: flex;
  align-items: center;
  height: 72rpx;
  border-top: 1rpx solid #eef0e8;
  font-size: 26rpx;
  color: #3d4f52;
}

.v {
  margin-left: auto;
  color: #6b7c7c;
  font-size: 24rpx;
}

.thead,
.tr {
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  height: 68rpx;
  border-top: 1rpx solid #eef0e8;
  font-size: 24rpx;
  color: #3d4f52;
}

.thead {
  color: #8c9b98;
  height: 56rpx;
  border-top: 1rpx solid #e4e8dc;
}

.c1 {
  width: 24%;
}
.c2 {
  width: 19%;
}
.c3 {
  width: 19%;
}
.c4 {
  width: 19%;
}
.c5 {
  width: 19%;
  text-align: right;
}
