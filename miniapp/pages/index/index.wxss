.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #16262b;
  color: #f0f3ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.coach-body {
  margin-left: 4rpx;
}

.coach-msg {
  font-size: 28rpx;
  line-height: 1.65;
  margin-top: 4rpx;
}

.pct {
  font-family: Menlo, Consolas, monospace;
  font-size: 72rpx;
  line-height: 1.1;
  color: #16262b;
  margin-top: 12rpx;
}

.pct-unit {
  font-size: 30rpx;
  color: #6b7c7c;
  margin-left: 4rpx;
}

.rows {
  margin-top: 24rpx;
}

.trow {
  display: flex;
  align-items: center;
  height: 64rpx;
  font-size: 26rpx;
  color: #3d4f52;
  border-top: 1rpx solid #eef0e8;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d6dbd0;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot-on {
  background: #0f6b5c;
}

.tlabel {
  color: #3d4f52;
}

.tval {
  margin-left: auto;
  font-size: 24rpx;
  color: #6b7c7c;
}

.foot {
  text-align: center;
  margin-top: 32rpx;
}

/* 纯复习：次要按钮 */
.btn-review {
  margin-top: 16rpx;
  background: transparent;
  border-color: #d6dbd0;
  color: #3d4f52;
  box-shadow: none;
}
