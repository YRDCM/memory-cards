<view class="wrap">

  <!-- 顶部进度 -->
  <view class="top">
    <text class="mono counter">{{idx}} / {{total}}</text>
    <view class="grow bar-wrap">
      <view class="bar">
        <view class="bar-fill" style="width: {{pct}}%"></view>
      </view>
    </view>
    <text class="tiny end" bindtap="onEnd">结束</text>
  </view>

  <!-- 卡片 -->
  <view class="flashcard">
    <view class="fc-head">
      <view class="tab tiny">{{isNew ? 'NEW' : 'REVIEW'}}</view>
      <!-- 填空和拼写要产出这个单词，这两档不给发音按钮 -->
      <view wx:if="{{ttsOk && stage !== 'cloze' && stage !== 'spell'}}" class="fc-say" bindtap="onSpeak" hover-class="fc-say-hover">🔊</view>
    </view>

    <!-- 拼写模式 -->
    <block wx:if="{{stage === 'spell'}}">
      <view class="fc-body">
        <view class="meaning">{{cn}}</view>
        <view class="pos">{{pos}} · 根据释义拼出这个单词</view>
        <input class="spell-input" value="{{input}}" bindinput="onInput" focus="{{true}}"
               placeholder="在这里拼写" placeholder-class="ph" confirm-type="done" bindconfirm="onCheck" />
      </view>
      <view class="fc-foot">
        <view class="btn btn-primary btn-block" bindtap="onCheck">检查</view>
      </view>
    </block>

    <!-- 拼写结果 -->
    <block wx:elif="{{stage === 'spellResult'}}">
      <view class="fc-body">
        <view class="word {{spellOk ? 'ok' : 'bad'}}">{{word}}</view>
        <view class="pos">{{pos}} · {{spellOk ? '✓ 拼对了' : '✗ 正确写法是这样'}}</view>
        <view class="meaning">{{cn}}</view>
        <view wx:if="{{ex}}" class="ex">{{ex}}<text class="ex-say" catchtap="onSpeakEx"> 🔊</text></view>
        <view wx:if="{{excn}}" class="excn">{{excn}}</view>
      </view>
      <view class="fc-foot">
        <view class="btn btn-primary btn-block" bindtap="onSpellNext">继续</view>
      </view>
    </block>

    <!-- 选择题 -->
    <block wx:elif="{{stage === 'choice'}}">
      <view class="fc-body">
        <view class="quiz-tag">{{quizTag}}</view>
        <view class="word">{{word}}</view>
        <view class="pos">{{pos}}</view>
      </view>
      <view class="options">
        <view class="opt" wx:for="{{options}}" wx:key="index" data-i="{{index}}" bindtap="onPick">
          <text class="opt-key">{{keys[index]}}</text>
          <text class="opt-txt">{{item}}</text>
        </view>
      </view>
    </block>

    <!-- 例句填空 -->
    <block wx:elif="{{stage === 'cloze'}}">
      <view class="fc-body">
        <view class="quiz-tag">{{quizTag}}</view>
        <view class="cloze-sentence">{{cloze.sentence}}</view>
        <view class="meaning">{{hintCn}}</view>
        <input class="spell-input" value="{{input}}" bindinput="onInput" focus="{{true}}"
               placeholder="拼出这个单词" placeholder-class="ph" confirm-type="done" bindconfirm="onClozeCheck" />
      </view>
      <view class="fc-foot">
        <view class="btn btn-primary btn-block" bindtap="onClozeCheck">检查</view>
      </view>
    </block>

    <!-- 答题结果 -->
    <block wx:elif="{{stage === 'quizResult'}}">
      <view class="fc-body">
        <view class="word {{lastOk ? 'ok' : 'bad'}}">{{word}}</view>
        <view class="pos">{{pos}} · {{lastOk ? '✓ 答对了' : '✗ 没答对'}}</view>
        <view class="meaning">{{cn}}</view>
        <view wx:if="{{ex}}" class="ex">{{ex}}<text class="ex-say" catchtap="onSpeakEx"> 🔊</text></view>
        <view wx:if="{{excn}}" class="excn">{{excn}}</view>

        <view wx:if="{{memoParts.length || memoFam.length}}" class="memo">
          <view wx:if="{{memoParts.length}}" class="memo-row">
            <text class="memo-k">拆解</text>
            <view class="memo-v">
              <block wx:for="{{memoParts}}" wx:key="index">
                <text wx:if="{{index > 0}}" class="memo-dot">+</text>
                <text class="memo-t">{{item.t}}</text>
                <text class="memo-g">{{item.g}}</text>
              </block>
            </view>
          </view>
          <view wx:if="{{memoFam.length}}" class="memo-row">
            <text class="memo-k">词族</text>
            <view class="memo-v">
              <block wx:for="{{memoFam}}" wx:key="index">
                <text wx:if="{{index > 0}}" class="memo-dot">·</text>
                <text class="memo-t">{{item.w}}</text>
                <text class="memo-g">{{item.g}}</text>
              </block>
            </view>
          </view>
        </view>
      </view>
      <view class="fc-foot">
        <view class="btn btn-primary btn-block" bindtap="onQuizNext">继续</view>
      </view>
    </block>

    <!-- 正面 -->
    <block wx:elif="{{!revealed}}">
      <view class="fc-body">
        <view class="word">{{word}}</view>
        <view class="pos">{{pos}}</view>
        <view class="hint">先在心里回想它的意思，再翻开</view>
      </view>
      <view class="fc-foot">
        <view class="btn btn-primary" bindtap="onFlip">显示释义</view>
      </view>
    </block>

    <!-- 背面 -->
    <block wx:else>
      <view class="fc-body">
        <view class="word">{{word}}</view>
        <view class="pos">{{posLine}}</view>
        <view class="meaning">{{cn}}</view>
        <view wx:if="{{ex}}" class="ex">{{ex}}<text class="ex-say" catchtap="onSpeakEx"> 🔊</text></view>
        <view wx:if="{{excn}}" class="excn">{{excn}}</view>

        <view wx:if="{{memoParts.length || memoFam.length}}" class="memo">
          <view wx:if="{{memoParts.length}}" class="memo-row">
            <text class="memo-k">拆解</text>
            <view class="memo-v">
              <block wx:for="{{memoParts}}" wx:key="index">
                <text wx:if="{{index > 0}}" class="memo-dot">+</text>
                <text class="memo-t">{{item.t}}</text>
                <text class="memo-g">{{item.g}}</text>
              </block>
            </view>
          </view>
          <view wx:if="{{memoFam.length}}" class="memo-row">
            <text class="memo-k">词族</text>
            <view class="memo-v">
              <block wx:for="{{memoFam}}" wx:key="index">
                <text wx:if="{{index > 0}}" class="memo-dot">·</text>
                <text class="memo-t">{{item.w}}</text>
                <text class="memo-g">{{item.g}}</text>
              </block>
            </view>
          </view>
        </view>
      </view>

      <view class="grades">
        <view class="grade" data-g="1" bindtap="onGrade">
          <text class="g-name">忘了</text>
          <text class="g-when">{{pre1}}</text>
        </view>
        <view class="grade" data-g="2" bindtap="onGrade">
          <text class="g-name">模糊</text>
          <text class="g-when">{{pre2}}</text>
        </view>
        <view class="grade" data-g="3" bindtap="onGrade">
          <text class="g-name">会了</text>
          <text class="g-when">{{pre3}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
