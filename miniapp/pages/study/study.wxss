.wrap {
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.counter {
  font-size: 24rpx;
  color: #6b7c7c;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bar-wrap {
  margin-right: 20rpx;
}

.end {
  flex-shrink: 0;
}

/* ---------- 卡片 ---------- */

.flashcard {
  position: relative;
  display: flex;
  flex-direction: column;
  background: #fafbf6;
  border: 1rpx solid #d6dbd0;
  border-radius: 24rpx;
  padding: 56rpx 44rpx 40rpx 44rpx;
  min-height: 500rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 30rpx -18rpx rgba(22, 38, 43, 0.5);
}

.fc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 0;
}

.fc-foot {
  margin-top: 32rpx;
}

.foot-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.foot-row .speak {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #3d4f52;
  background: #f3f5ee;
}

.foot-row .grow-btn {
  flex: 1;
  height: 88rpx;
}

.tab {
  position: absolute;
  top: 24rpx;
  right: 30rpx;
  letter-spacing: 2rpx;
}

.word {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 84rpx;
  line-height: 1.1;
  letter-spacing: -1rpx;
  word-break: break-all;
}

.word.ok {
  color: #2e7d5b;
}

.word.bad {
  color: #b4472a;
}

.pos {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #6b7c7c;
  letter-spacing: 1rpx;
  margin-top: 10rpx;
}

.meaning {
  font-size: 42rpx;
  line-height: 1.5;
  margin-top: 24rpx;
}

.hint {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #8c9b98;
  margin-top: 24rpx;
}

.ex {
  margin-top: 32rpx;
  padding-left: 20rpx;
  border-left: 4rpx solid #d6dbd0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 32rpx;
  line-height: 1.55;
  color: #3d4f52;
}

.excn {
  margin-top: 8rpx;
  padding-left: 20rpx;
  font-size: 26rpx;
  color: #6b7c7c;
  line-height: 1.55;
}

/* ---------- 评分 ---------- */

.grades {
  display: flex;
  margin-top: 36rpx;
}

.grade {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  border: 1rpx solid #d6dbd0;
  border-radius: 18rpx;
  margin-right: 16rpx;
  background: #fafbf6;
}

.grade:last-child {
  margin-right: 0;
}

.grade:active {
  background: #f3f5ee;
}

.g-name {
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.g-when {
  font-family: Menlo, Consolas, monospace;
  font-size: 20rpx;
  color: #6b7c7c;
  margin-top: 6rpx;
}

/* ---------- 拼写 ---------- */

.spell-input {
  height: 120rpx;
  border-bottom: 3rpx solid #d6dbd0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 56rpx;
  margin: 36rpx 0 0;
  padding: 0 4rpx;
}

.ph {
  color: #b9c2b6;
  font-size: 40rpx;
}

/* ---------- 复习题型 ---------- */

.quiz-tag {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #6b7c7c;
  margin-bottom: 24rpx;
}

.options {
  margin-top: 32rpx;
}

.opt {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border: 1rpx solid #d6dbd0;
  border-radius: 16rpx;
  background: #fafbf6;
  margin-bottom: 14rpx;
}

.opt:last-child {
  margin-bottom: 0;
}

.opt:active {
  background: #f3f5ee;
}

.opt-key {
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: #6b7c7c;
  border: 1rpx solid #d6dbd0;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.opt-txt {
  font-size: 28rpx;
  line-height: 1.45;
}

.cloze-sentence {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 36rpx;
  line-height: 1.6;
  color: #16262b;
  margin-bottom: 20rpx;
}

/* ---------- 记忆联动 ---------- */

.memo {
  margin-top: 32rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed #d6dbd0;
}

.memo-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.8;
  color: #3d4f52;
  margin-bottom: 6rpx;
}

.memo-k {
  flex-shrink: 0;
  width: 64rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #6b7c7c;
  padding-top: 4rpx;
}

.memo-v {
  flex: 1;
  min-width: 0;
}

.memo-t {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28rpx;
  color: #0b5548;
}

.memo-g {
  color: #6b7c7c;
  margin-left: 8rpx;
}

.memo-dot {
  color: #b9c2b6;
  margin: 0 10rpx;
}
