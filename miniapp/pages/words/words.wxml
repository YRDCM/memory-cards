<view class="page">

  <view class="chips">
    <view class="chip {{filter === 'all' ? 'chip-on' : ''}}" data-f="all" bindtap="onFilter">全部 {{counts.all}}</view>
    <view class="chip {{filter === 'new' ? 'chip-on' : ''}}" data-f="new" bindtap="onFilter">未学 {{counts.new}}</view>
    <view class="chip {{filter === 'learn' ? 'chip-on' : ''}}" data-f="learn" bindtap="onFilter">学习中 {{counts.learn}}</view>
    <view class="chip {{filter === 'due' ? 'chip-on' : ''}}" data-f="due" bindtap="onFilter">待复习 {{counts.due}}</view>
    <view class="chip {{filter === 'ok' ? 'chip-on' : ''}}" data-f="ok" bindtap="onFilter">已掌握 {{counts.ok}}</view>
  </view>

  <input class="input search" placeholder="搜索单词或释义" value="{{query}}" bindinput="onSearch" />

  <view class="list">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-main">
        <text class="w">{{item.w}}</text>
        <text class="cn">{{item.pos}} {{item.cn}}</text>
      </view>
      <text wx:if="{{item.times}}" class="times">×{{item.times}}</text>
      <text class="badge {{item.cls}}">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="btn btn-ghost btn-block more" bindtap="onMore">
    加载更多（{{shown}} / {{total}}）
  </view>
  <view wx:if="{{!items.length}}" class="empty">没有符合条件的词</view>
</view>
