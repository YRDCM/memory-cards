/* 全局样式 —— 纸与铅笔 */

page {
  background-color: #edefe8;
  color: #16262b;
  font-size: 30rpx;
  line-height: 1.65;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */

.card {
  background: #fafbf6;
  border: 1rpx solid #d6dbd0;
  border-radius: 22rpx;
  box-shadow: 0 2rpx 4rpx rgba(22, 38, 43, 0.05);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-pad {
  padding: 28rpx 30rpx;
}

.row {
  display: flex;
  align-items: center;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ---------- 文字 ---------- */

.h1 {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.h2 {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.muted {
  color: #6b7c7c;
}

.tiny {
  font-size: 22rpx;
  color: #6b7c7c;
  letter-spacing: 1rpx;
}

.mono {
  font-family: Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.accent {
  color: #0f6b5c;
}

.warn {
  color: #b4472a;
}

.gold {
  color: #c9902a;
}

/* ---------- 按钮 ---------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  border: 1rpx solid #d6dbd0;
  background: #fafbf6;
  color: #16262b;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #0f6b5c;
  border-color: #0f6b5c;
  color: #f7faf5;
}

.btn-ghost {
  background: transparent;
  border-color: transparent;
  color: #6b7c7c;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
}

.btn-block {
  width: 100%;
}

/* ---------- 标签 ---------- */

.chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid #d6dbd0;
  background: #fafbf6;
  font-size: 26rpx;
  color: #3d4f52;
}

.chip-on {
  background: #16262b;
  border-color: #16262b;
  color: #f5f7f1;
}

.badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.badge-new {
  color: #6b7c7c;
  border: 1rpx solid #d6dbd0;
}

.badge-learn {
  color: #c9902a;
  background: #f5e9cf;
}

.badge-due {
  color: #b4472a;
  background: #f3ddd6;
}

.badge-ok {
  color: #0b5548;
  background: #dceae3;
}

.badge-expert {
  color: #14425a;
  background: #dfeaf2;
}

/* ---------- 进度条 ---------- */

.bar {
  height: 14rpx;
  background: #e4e8dc;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #0f6b5c;
  border-radius: 999rpx;
}

/* ---------- 输入 ---------- */

.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f3f5ee;
  border: 1rpx solid #d6dbd0;
  border-radius: 14rpx;
  font-size: 28rpx;
}

/* ---------- 空状态 ---------- */

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #6b7c7c;
  font-size: 26rpx;
}

/* ---------- 同步状态 ---------- */

.sync-line {
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: #6b7c7c;
  margin-top: 12rpx;
  line-height: 1.7;
}

.sync-bad {
  color: #b4472a;
}

.sync-good {
  color: #2e7d5b;
}
